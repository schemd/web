{
	"name": "schemd-web",
	"version": "0.2.0",
	"packageManager": "bun@1.4.3",
	"engines": {
		"node": ">=24"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-bun": "^1.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/katex": "^0.16.8",
		"@types/node": "^26",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	},
	"private": true,
	"scripts": {
		"dev": "vite dev --port 3000",
		"dev:exposed": "vite dev --host --port 3000",
		"build": "bun --bun vite build",
		"preview": "vite preview --port 3000",
		"preview:exposed": "vite preview --host --port 3000",
		"prepare": "svelte-kit sync || echo ''",
		"start": "bun ./build",
		"start:test": "SCHEMD_REGISTRY_OFFLINE=1 HOST=127.0.0.1 PORT=4173 bun ./build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"ci": "bun install --frozen-lockfile",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run --project server",
		"test:e2e": "playwright test",
		"test:a11y": "playwright test e2e/accessibility.e2e.ts",
		"test:budget": "bun run build && bun scripts/check-build-budget.ts",
		"test": "bun run check && bun run test:unit && bun run test:e2e",
		"release:check": "bun run ci && bun run format:check && bun run lint && bun run check && bun run test:unit && bun run test:docs && bun run test:e2e && bun run test:budget",
		"test:docs": "bun scripts/check-doc-fences.ts",
		"test:fuzz": "FUZZ_FULL=1 playwright test e2e/fuzz.e2e.ts"
	},
	"type": "module",
	"dependencies": {
		"@schemd/core": "^1.2.0",
		"katex": "^0.19.0",
		"marked": "^18.1.1",
		"shiki": "^4.5.0"
	},
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	}
}
